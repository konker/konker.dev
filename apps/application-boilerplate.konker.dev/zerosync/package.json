{
  "name": "@konker.dev/application-boilerplate.konker.dev-zerosync",
  "version": "0.0.1",
  "type": "module",
  "author": "Konrad Markus <mail@konker.dev>",
  "license": "ISC",
  "description": "Isomorphic Zero Sync schema/queries/mutators shared by the application-boilerplate backend and frontend",
  "homepage": "https://konker.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/konker.dev/apps/application-boilerplate.konker.dev"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*"
  ],
  "main": "dist/index.js",
  "types": "src/index.ts",
  "comment:exports": "Types are exposed from TS source (consumers use moduleResolution=bundler); runtime JS is built to dist. zerosync deliberately emits no .d.ts to avoid TS2742 from Zero's deep internal types. Not published (workspace-only), so shipping src for types is fine.",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "source": "./src/schema.ts",
      "types": "./src/schema.ts",
      "import": "./dist/schema.js"
    },
    "./queries": {
      "source": "./src/queries.ts",
      "types": "./src/queries.ts",
      "import": "./dist/queries.js"
    },
    "./mutators": {
      "source": "./src/mutators.ts",
      "types": "./src/mutators.ts",
      "import": "./dist/mutators.js"
    },
    "./auth": {
      "source": "./src/auth.ts",
      "types": "./src/auth.ts",
      "import": "./dist/auth.js"
    }
  },
  "peerDependencies": {
    "@rocicorp/zero": "^1.6.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@konker.dev/common-config": "^0.7.0",
    "@rocicorp/zero": "^1.6.2",
    "@types/node": "^25.0.6",
    "@vitest/coverage-istanbul": "^4.0.16",
    "eslint": "^9.39.2",
    "madge": "^8.0.0",
    "prettier": "^3.7.4",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "zod": "^3.25.67"
  },
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "circular-check": "madge --extensions ts --circular --no-color --no-spinner --warning src",
    "eslint-check": "eslint --max-warnings=0 '**/*.{ts,js,json}'",
    "eslint-fix": "npx eslint --fix||true",
    "fixme-check": "leasot --exit-nicely --skip-unsupported src",
    "prettier-check": "npx prettier --check --ignore-path .gitignore --ignore-path .prettierignore '**/*.{css,html,js,ts,json,md,yaml,yml}'",
    "prettier-fix": "pnpm run prettier-check --write",
    "lint-check": "pnpm run eslint-check && pnpm run prettier-check && pnpm run circular-check",
    "lint-fix": "pnpm run eslint-fix && pnpm run prettier-fix",
    "test": "vitest run --passWithNoTests",
    "typecov": "type-coverage --detail --at-least 95",
    "pre-push": "pnpm run lint-check && pnpm run typecheck",
    "ci": "pnpm run lint-check && pnpm run typecheck && pnpm run test && pnpm run build",
    "cd": "echo NOOP"
  }
}

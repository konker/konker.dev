{
  "name": "@konker.dev/application-boilerplate.konker.dev",
  "version": "0.0.1",
  "type": "module",
  "author": "Konrad Markus <mail@konker.dev>",
  "license": "ISC",
  "description": "Boilerplate for konker.dev application services",
  "homepage": "https://konker.dev/",
  "keywords": [
    "node",
    "utils",
    "typescript",
    "functional-programming",
    "effect-ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/konker.dev/apps/application-boilerplate.konker.dev"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*"
  ],
  "main": "dist/index.js",
  "dependencies": {
    "@dotenvx/dotenvx": "^2.1.4",
    "@effect/opentelemetry": "^0.63.0",
    "@effect/platform": "^0.96.2",
    "@effect/platform-node": "^0.107.0",
    "@effect/sql": "^0.51.1",
    "@effect/sql-drizzle": "^0.50.0",
    "@effect/sql-pg": "^0.52.1",
    "@hono/node-server": "^2.0.8",
    "@konker.dev/application-boilerplate.konker.dev-zerosync": "workspace:*",
    "@konker.dev/middleware-fp": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "@rocicorp/zero": "^1.7.0",
    "aws-lambda": "^1.0.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.4",
    "hono": "4.12.27",
    "jose": "^6.2.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@effect/language-service": "^0.86.4",
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@konker.dev/common-config": "^0.8.0",
    "@konker.dev/config-o-tron": "0.0.2",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-istanbul": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-plugin-fp": "^2.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "leasot": "^14.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.4",
    "sst": "^4.17.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "build": "pnpm run clean && tsup",
    "build:prod": "pnpm run build && pnpm deploy --filter @konker.dev/application-boilerplate.konker.dev --prod ./.deploy",
    "build-container": "pnpm run build:prod && docker buildx build -t $AWS_ECR_REGISTRY/$AWS_ECR_REPOSITORY:$IMAGE_TAG -f ./deployment/Dockerfile .",
    "push-container": "aws ecr get-login-password --region ${AWS_DEFAULT_REGION:-eu-west-1} | docker login --username AWS --password-stdin $AWS_ECR_REGISTRY && docker push $AWS_ECR_REGISTRY/$AWS_ECR_REPOSITORY:$IMAGE_TAG",
    "predev": "pnpm --filter @konker.dev/application-boilerplate.konker.dev-zerosync run build",
    "dev": "dotenvx run --env-file .env.local.development -- tsx watch src/hono/hono-node-server.ts",
    "ci": "pnpm run lint-check && pnpm run typecheck && pnpm run type-coverage-check && pnpm run test && pnpm run build && pnpm run fixme-check",
    "cd": "echo NOOP",
    "db:generate": "dotenvx run --env-file .env.local.development -- drizzle-kit generate --config=src/config/drizzle.config.ts",
    "db:migrate": "dotenvx run --env-file .env.local.development -- drizzle-kit migrate --config=src/config/drizzle.config.ts",
    "mint-jwt": "dotenvx run --env-file .env.local.development -- tsx scripts/MintDevJwt.ts",
    "circular-check": "madge --extensions ts --circular --no-color --no-spinner --warning src",
    "clean": "rm -rf dist && rm -rf .deploy && rm -f tsconfig.tsbuildinfo",
    "codecov": "npx --package=@konker.dev/common-config codecov-upload `pwd` '@konker.dev/application-boilerplate'",
    "eslint-check": "eslint --max-warnings=0 '**/*.{ts,js,json}'",
    "eslint-fix": "npx eslint --fix||true",
    "fixme-check": "leasot --exit-nicely --skip-unsupported src",
    "lint-check": "pnpm run eslint-check && pnpm run prettier-check && pnpm run circular-check && pnpm run fixme-check",
    "lint-fix": "pnpm run eslint-fix && pnpm run prettier-fix",
    "pre-push": "pnpm run lint-check && pnpm run typecheck",
    "prettier-check": "npx prettier --check --ignore-path .gitignore --ignore-path .prettierignore '**/*.{css,html,js,ts,json,md,yaml,yml}'",
    "prettier-fix": "pnpm run prettier-check --write",
    "test": "vitest run --coverage",
    "type-coverage-check": "type-coverage --detail --at-least 99 --ignore-files src/index.test.ts --ignore-files src/stream/index.ts",
    "typecheck": "tsc --noEmit"
  }
}

    },
    "./http/contrib/pathTokenAuthorizer": {
      "types": "./dist/http/contrib/pathTokenAuthorizer.d.ts",
      "import": "./dist/http/contrib/pathTokenAuthorizer.js"
    },
    "./http/contrib/queryStringValidator": {
